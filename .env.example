# Public Supabase client configuration only. Never set service_role or AI keys here.
# Leave empty for fully local reading. These values are embedded in web bundles.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_APP_URL=https://asahi12-26.github.io/open-novel-reader/
# Set team-test only for Supabase built-in email testing with organization members.
# Shows a test-stage notice; leave empty for a self-hosted SMTP deployment.
VITE_AUTH_EMAIL_MODE=
# DeepSeek API keys are entered by the user at runtime and held only in memory.
